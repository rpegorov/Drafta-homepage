<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/publisher/install.mjs (PLAN v2 §11.1 п. 1, 3, 6, 7). A one-shot job: launchd starts it on a change under the notes directory, at load and every 30 minutes; it never stays alive on its own. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{LABEL}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{SCRIPT}}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{CLONE}}</string>
  <key>WatchPaths</key>
  <array>
    <string>{{NOTES}}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>{{HOME}}</string>
    <key>DRAFTA_LIBRARY</key>
    <string>{{LIBRARY}}</string>
    <key>PUBLISHER_BRANCH</key>
    <string>{{BRANCH}}</string>
    <key>GIT_SSH_COMMAND</key>
    <string>{{GIT_SSH_COMMAND}}</string>
    <key>GIT_TERMINAL_PROMPT</key>
    <string>0</string>
{{EXTRA_ENV}}  </dict>
  <key>StandardOutPath</key>
  <string>{{LOG}}</string>
  <key>StandardErrorPath</key>
  <string>{{LOG}}</string>
</dict>
</plist>
