---
/* /verify/ — confirm email. Text, state markup (data-state, data-invalid-reason,
   data-retry) ported 1:1 from the old page at commit c497677;
   scripts/pages/verify.ts owns the logic. A ?token= link can carry sensitive
   query data, so this page also strips the referrer. */
import Base from '../../layouts/Base.astro';
---
<Base
  lang="en"
  title="Confirm your email — Drafta"
  description="Confirm the email address of your Drafta account by opening the link we mailed you."
  canonicalPath="/verify/"
  noindex
>
  <Fragment slot="head">
    <meta name="referrer" content="no-referrer">
  </Fragment>

  <section class="band band--soft">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Account</p>
      <h1 class="h1">Confirm your email address</h1>
      <p class="lede">The link in the email from Drafta opens this page. Confirming the address is what activates the account.</p>
      <noscript>
        <p class="muted">Confirming your address needs JavaScript. Turn it on and open the link from the email again.</p>
      </noscript>

      <div class="form is-hidden" data-state="checking" hidden role="status">
        <h2 class="h3">Confirming your address…</h2>
        <p class="callout">Talking to the accounts service. This takes a second.</p>
      </div>

      <div class="form is-hidden" data-state="incomplete" hidden>
        <h2 class="h3">This link is incomplete</h2>
        <p class="callout">The confirmation link arrived without its token, so there is nothing to confirm. Copy the whole link out of the email exactly as it was sent — and note that a fresh link cannot be requested from the site yet.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/login/">Sign in</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="confirmed" hidden role="status">
        <h2 class="h3">Your email address is confirmed</h2>
        <p class="form__ok">Thanks — the accounts service accepted the link. Sign in with this address to choose a plan.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/login/">Sign in</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="already" hidden role="status">
        <h2 class="h3">This address was confirmed earlier</h2>
        <p class="form__ok">Nothing left to do — the account was already activated with an earlier link. Sign in to carry on.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/login/">Sign in</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="invalid" hidden>
        <h2 class="h3">This link is invalid or has expired</h2>
        <p class="form__error" data-invalid-reason></p>
        <p class="muted">A fresh confirmation link cannot be requested from the site yet — there is no resend option. If this address is already confirmed, signing in is the way in.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/login/">Sign in</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="error" hidden>
        <h2 class="h3">We could not confirm this link</h2>
        <p class="form__error">The accounts service did not answer. Check your connection and try again.</p>
        <div class="form__actions">
          <button class="btn btn--primary" type="button" data-retry>Try again</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../../scripts/pages/verify.ts';
  </script>
</Base>
