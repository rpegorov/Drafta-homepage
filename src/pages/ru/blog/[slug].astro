---
import Post from '../../../layouts/Post.astro';
import { postsOf, twinOf } from '../../../components/blog/posts';

export async function getStaticPaths() {
  const posts = await postsOf('ru');
  return Promise.all(
    posts.map(async (post) => ({ params: { slug: post.data.slug }, props: { post, twin: await twinOf(post) } })),
  );
}

const { post, twin } = Astro.props;
---
<Post post={post} twin={twin} />
