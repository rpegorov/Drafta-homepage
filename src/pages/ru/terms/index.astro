---
/* Условия использования (RU). Текст — src/content/legal/ru/terms.md; страница
   отвечает только за каркас Base и общую типографику .legal. */
import Base from '../../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('legal', 'ru/terms');
if (!entry) throw new Error('content/legal/ru/terms.md is missing');
const { Content } = await render(entry);
---
<Base lang="ru" title={`${entry.data.title} — Drafta`} description={entry.data.description} canonicalPath="/ru/terms/" noindex={true}>
  <article class="wrap wrap--narrow legal">
    <h1 class="h1">{entry.data.title}</h1>
    <Content />
  </article>
</Base>

<style>
  .legal{padding-block:var(--space-8)}
  .legal :global(h2){font-family:var(--font-display);font-weight:600;font-size:24px;line-height:1.2;letter-spacing:-0.01em;color:var(--ink);margin:var(--space-8) 0 var(--space-4)}
  .legal :global(ul){margin:0 0 var(--space-4);padding-inline-start:var(--space-5)}
  .legal :global(li){margin-bottom:var(--space-2)}
  .legal :global(hr){margin:var(--space-8) 0}
  .legal :global(em){color:var(--ink-soft)}
</style>
