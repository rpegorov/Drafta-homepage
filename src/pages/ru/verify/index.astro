---
/* /ru/verify/ — подтверждение адреса. Текст и разметка состояний перенесены
   1:1 из старой страницы (коммит c497677); логика — в scripts/pages/verify.ts.
   Ссылка с ?token= может нести чувствительные данные в query — referrer
   отключён и здесь. */
import Base from '../../../layouts/Base.astro';
---
<Base
  lang="ru"
  title="Подтверждение адреса — Drafta"
  description="Подтвердите адрес почты аккаунта Drafta, открыв ссылку из письма."
  canonicalPath="/ru/verify/"
  noindex
>
  <Fragment slot="head">
    <meta name="referrer" content="no-referrer">
  </Fragment>

  <section class="band band--soft">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">Аккаунт</p>
      <h1 class="h1">Подтвердите адрес почты</h1>
      <p class="lede">Ссылка из письма Drafta открывает эту страницу. Подтверждение адреса и активирует аккаунт.</p>
      <noscript>
        <p class="muted">Для подтверждения адреса нужен JavaScript. Включите его и откройте ссылку из письма снова.</p>
      </noscript>

      <div class="form is-hidden" data-state="checking" hidden role="status">
        <h2 class="h3">Подтверждаем адрес…</h2>
        <p class="callout">Обращаемся к службе аккаунтов. Это займёт секунду.</p>
      </div>

      <div class="form is-hidden" data-state="incomplete" hidden>
        <h2 class="h3">Ссылка неполная</h2>
        <p class="callout">В ссылке для подтверждения нет токена, подтверждать нечего. Скопируйте ссылку из письма целиком, как она была отправлена — и учтите, что запросить новую ссылку с сайта пока нельзя.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/ru/login/">Войти</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="confirmed" hidden role="status">
        <h2 class="h3">Адрес почты подтверждён</h2>
        <p class="form__ok">Спасибо — служба аккаунтов приняла ссылку. Войдите с этим адресом, чтобы выбрать тариф.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/ru/login/">Войти</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="already" hidden role="status">
        <h2 class="h3">Этот адрес подтвердили раньше</h2>
        <p class="form__ok">Делать ничего не нужно — аккаунт уже активирован более ранней ссылкой. Войдите, чтобы продолжить.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/ru/login/">Войти</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="invalid" hidden>
        <h2 class="h3">Ссылка недействительна или истекла</h2>
        <p class="form__error" data-invalid-reason></p>
        <p class="muted">Запросить новую ссылку для подтверждения с сайта пока нельзя — повторная отправка не предусмотрена. Если адрес уже подтверждён, войти можно с этой страницы.</p>
        <div class="form__actions">
          <a class="btn btn--primary" href="/ru/login/">Войти</a>
        </div>
      </div>

      <div class="form is-hidden" data-state="error" hidden>
        <h2 class="h3">Не удалось подтвердить ссылку</h2>
        <p class="form__error">Служба аккаунтов не ответила. Проверьте соединение и попробуйте снова.</p>
        <div class="form__actions">
          <button class="btn btn--primary" type="button" data-retry>Попробовать снова</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import '../../../scripts/pages/verify.ts';
  </script>
</Base>
