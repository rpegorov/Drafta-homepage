---
/* Refund Policy (EN). Body copy lives in src/content/legal/en/refund.md;
   this page only supplies the Base frame and the shared .legal typography. */
import Base from '../../layouts/Base.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('legal', 'en/refund');
if (!entry) throw new Error('content/legal/en/refund.md is missing');
const { Content } = await render(entry);
---
<Base lang="en" title={`${entry.data.title} — Drafta`} description={entry.data.description} canonicalPath="/refund/" noindex={true}>
  <article class="wrap wrap--narrow legal">
    <h1 class="h1">{entry.data.title}</h1>
    <Content />
  </article>
</Base>

<style>
  .legal{padding-block:var(--space-8)}
  .legal :global(h2){font-family:var(--font-display);font-weight:600;font-size:24px;line-height:1.2;letter-spacing:-0.01em;color:var(--ink);margin:var(--space-8) 0 var(--space-4)}
  .legal :global(ul){margin:0 0 var(--space-4);padding-inline-start:var(--space-5)}
  .legal :global(li){margin-bottom:var(--space-2)}
  .legal :global(hr){margin:var(--space-8) 0}
  .legal :global(em){color:var(--ink-soft)}
</style>
